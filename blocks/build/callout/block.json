{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "boltfolio/callout",
  "version": "0.1.0",
  "title": "Callout",
  "category": "design",
  "icon": "lightbulb",
  "description": "Highlighted info, tip or warning box for documentation.",
  "keywords": [
    "callout",
    "note",
    "tip",
    "warning",
    "docs"
  ],
  "example": {
    "attributes": {
      "type": "tip",
      "title": "Pro tip"
    }
  },
  "supports": {
    "html": false
  },
  "attributes": {
    "type": {
      "type": "string",
      "default": "info"
    },
    "title": {
      "type": "string",
      "default": ""
    }
  },
  "textdomain": "boltfolio",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "render": "file:./render.php"
}